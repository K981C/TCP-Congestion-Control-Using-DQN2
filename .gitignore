# .gitignore for CongestionControlTCP project
# Purpose: ignore local envs, build artifacts, binaries, caches and model/data outputs

## OS
.DS_Store
Thumbs.db

## Editors / IDEs
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

## Python virtualenv
/.venv/
venv/
env/
ENV/

## Python
__pycache__/
*.py[cod]
*$py.class
*.pyo

## Packaging
/build/
/dist/
*.egg-info/
pip-wheel-metadata/

## Tests / caches
.pytest_cache/
.mypy_cache/
.cache/
.tox/
htmlcov/
coverage.xml
.coverage

## Jupyter
.ipynb_checkpoints/

## Logs and temporary files
*.log
*.tmp
tmp/
temp/

## Model weights / output datasets
*.pth
*.pt
*.h5
models/
checkpoints/
data/
datasets/
results/

## C/C++ and build artifacts
*.o
*.so
*.a
*.lo
*.la
*.obj
*.dll
*.exe
*.out
*.elf
*.bin
*.dSYM/

## CMake
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile

## ns-3 / netanim / bake build outputs (ignore build artifacts, not sources)
ns-allinone-*/build/
ns-allinone-*/ns-*/build/
ns-*/build/
*/build/
*/bake/
netanim-*/

## Misc
*.swp
*~
desktop.ini
