exec_prefix="/usr/local/bin"
libdir="/usr/local/lib"
includedir="/usr/local/include"

Name: ns3-visualizer
Description: 
URL: 
Version: 3.40
Requires:  ns3-core ns3-internet ns3-wifi ns3-point-to-point ns3-csma ns3-bridge ns3-wimax ns3-lte ns3-mesh
Requires.private: 
Cflags: -I"${includedir}"  -I/usr/include/libxml2 -I/usr/include/python3.12
Libs: -L"${libdir}" -lns3.40-visualizer-default  -lns3.40-core-default -lns3.40-internet-default -lns3.40-wifi-default -lns3.40-point-to-point-default -lns3.40-csma-default -lns3.40-bridge-default -lns3.40-wimax-default -lns3.40-lte-default -lns3.40-mesh-default /usr/lib/x86_64-linux-gnu/libpython3.12.so
Libs.private: -L"${libdir}" 
